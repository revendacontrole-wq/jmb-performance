# JMB Performance - Environment Variables Template
# Copy this file to .env and fill in real values. DO NOT COMMIT .env TO GIT!

# Supabase PostgreSQL Connection String (Transaction Mode / Supavisor Port 6543)
DATABASE_URL=postgresql://postgres.your_supabase_id:your_password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Cryptographically generated secrets
SECRET_KEY=generate_crypto_random_secret_key_here
CPF_LOOKUP_SECRET=generate_crypto_random_cpf_lookup_secret_here

# Production Allowed Origins for CORS (comma separated)
ALLOWED_ORIGINS=https://jmb-performance.vercel.app,http://localhost:8000
